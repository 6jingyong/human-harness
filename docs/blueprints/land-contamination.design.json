{
  "schemaVersion": "design-v3-not-importable",
  "id": "land-contamination-investigation",
  "name": "土地污染调查",
  "officialScope": "建设用地土壤污染状况调查",
  "referenceStandards": [
    {
      "id": "HJ25.1-2019",
      "role": "调查阶段与工作程序",
      "source": "生态环境部",
      "verifyCurrentByLocation": true
    },
    {
      "id": "HJ25.2-2019",
      "role": "风险管控和修复监测技术导则，调查时结合适用条文",
      "source": "生态环境部",
      "verifyCurrentByLocation": true
    },
    {
      "id": "MEE-2022-QC",
      "role": "建设用地土壤污染状况调查质量控制技术规定（试行）",
      "source": "生态环境部2022年第17号公告",
      "verifyCurrentByLocation": true
    }
  ],
  "initialHumanTodo": [
    {
      "id": "H-001",
      "title": "确认项目身份与调查目的",
      "materialIds": [
        "project_identity"
      ],
      "required": true,
      "activeAt": "project.created"
    },
    {
      "id": "H-002",
      "title": "提供地块红线及空间定位",
      "materialIds": [
        "site_boundary"
      ],
      "required": true,
      "activeAt": "project.created"
    },
    {
      "id": "H-003",
      "title": "提供拟定用途及依据",
      "materialIds": [
        "planned_land_use"
      ],
      "required": true,
      "activeAt": "project.created"
    },
    {
      "id": "H-004",
      "title": "提交已有历史、企业、地勘和检测等材料",
      "materialIds": [
        "existing_records"
      ],
      "required": false,
      "activeAt": "project.created",
      "allow": [
        "provided",
        "skip_for_now",
        "unavailable"
      ]
    }
  ],
  "workflow": {
    "stages": [
      {
        "id": "S00",
        "title": "资料收集与核验",
        "canParallelWith": [
          "S10"
        ]
      },
      {
        "id": "S10",
        "title": "红线及空间范围解析"
      },
      {
        "id": "S20",
        "title": "历史影像、企业调查、踏勘与访谈"
      },
      {
        "id": "S30",
        "title": "污染识别与风险区域审核"
      },
      {
        "id": "G10",
        "title": "第一阶段是否进入采样调查",
        "type": "professional_decision",
        "choices": [
          "finish_stage1",
          "enter_sampling"
        ]
      },
      {
        "id": "S40",
        "title": "采样布点、指标与方案专业审核",
        "activeWhen": "G10 == enter_sampling"
      },
      {
        "id": "S50",
        "title": "委托现场与实验室服务",
        "activeWhen": "S40.plan_frozen == true"
      },
      {
        "id": "S60",
        "title": "现场采样、检测与质控证据收集",
        "activeWhen": "S50.commissioned == true"
      },
      {
        "id": "S70",
        "title": "检测/质控审核与结果评价",
        "activeWhen": "S60.evidence_accepted == true"
      },
      {
        "id": "S80",
        "title": "证据约束的章节编写及审核",
        "notes": "已有证据的部分可提前生成审核草稿"
      },
      {
        "id": "S90",
        "title": "脚本化报告汇编与验收"
      },
      {
        "id": "S95",
        "title": "签审与评审闭环"
      }
    ]
  },
  "materials": [
    {
      "id": "project_identity",
      "source": "human",
      "requiredWhen": "always",
      "requestWhen": "project.created",
      "acceptance": [
        "项目主体",
        "目标与范围"
      ]
    },
    {
      "id": "site_boundary",
      "source": "human",
      "requiredWhen": "always",
      "requestWhen": "project.created",
      "acceptance": [
        "原始资料保留",
        "可定位坐标",
        "边界审核"
      ]
    },
    {
      "id": "planned_land_use",
      "source": "human",
      "requiredWhen": "always",
      "requestWhen": "project.created",
      "acceptance": [
        "用途依据",
        "适用日期"
      ]
    },
    {
      "id": "existing_records",
      "source": "human",
      "requiredWhen": "available",
      "requestWhen": "project.created",
      "acceptance": [
        "按实际内容分类",
        "来源与日期"
      ]
    },
    {
      "id": "historical_imagery",
      "source": "agent_or_human",
      "requiredWhen": "stage1",
      "requestWhen": "S10.verified",
      "acceptance": [
        "真实来源",
        "年份",
        "原图记录",
        "人工核对"
      ]
    },
    {
      "id": "risk_enterprise_records",
      "source": "human_or_official_source",
      "requiredWhen": "risk_candidate_requires_confirmation",
      "requestWhen": "S20.candidates_approved",
      "acceptance": [
        "企业定位证据",
        "历史活动",
        "原始出处"
      ]
    },
    {
      "id": "sampling_plan",
      "source": "agent_and_professional",
      "requiredWhen": "sampling_branch",
      "requestWhen": "G10.enter_sampling",
      "acceptance": [
        "稳定点位ID",
        "审核后的坐标",
        "深度与指标",
        "理由与约束"
      ]
    },
    {
      "id": "commission_order",
      "source": "human_or_external_institution",
      "requiredWhen": "sampling_branch",
      "requestWhen": "S40.plan_frozen",
      "acceptance": [
        "批准的采样方案版本",
        "承接单位与工作范围"
      ]
    },
    {
      "id": "field_records",
      "source": "external_institution",
      "requiredWhen": "sampling_branch",
      "requestWhen": "S60.field_work_completed",
      "acceptance": [
        "点位/样品ID",
        "钻探/建井/采样记录",
        "流转记录"
      ]
    },
    {
      "id": "detection_report",
      "source": "external_institution",
      "requiredWhen": "sampling_branch",
      "requestWhen": "S60.lab_work_completed",
      "acceptance": [
        "正式报告",
        "点位/样品ID",
        "检测结果",
        "方法与必要资质信息"
      ]
    },
    {
      "id": "quality_control_records",
      "source": "external_institution",
      "requiredWhen": "sampling_branch",
      "requestWhen": "S60.qc_work_completed",
      "acceptance": [
        "现场/实验室质控证据",
        "检测对应关系",
        "可追溯记录与必要报告"
      ]
    },
    {
      "id": "professional_review",
      "source": "human_professional",
      "requiredWhen": "always",
      "requestWhen": "S90.compiled",
      "acceptance": [
        "审核意见闭环",
        "签发确认"
      ]
    }
  ],
  "triggerRules": [
    {
      "id": "T-risk-records",
      "when": "S20.new_risk_candidates_approved && missing(risk_enterprise_records)",
      "then": {
        "createHumanTodo": "调取所识别风险企业的原始档案"
      }
    },
    {
      "id": "T-sampling-review",
      "when": "G10 == enter_sampling && S40.candidates_ready",
      "then": {
        "createHumanTodo": "审核点位/采样深度/检测指标并冻结方案"
      }
    },
    {
      "id": "T-commission",
      "when": "S40.plan_frozen == true",
      "then": {
        "createHumanTodo": "委托采样/检测机构，提供任务书与执行安排"
      }
    },
    {
      "id": "T-field-evidence",
      "when": "S60.field_work_completed == true",
      "then": {
        "createHumanTodo": "提交现场采样、钻探和样品流转原始材料"
      }
    },
    {
      "id": "T-lab-evidence",
      "when": "S60.lab_work_completed == true",
      "then": {
        "createHumanTodo": "提交实验室检测报告"
      }
    },
    {
      "id": "T-qc-evidence",
      "when": "S60.qc_work_completed == true",
      "then": {
        "createHumanTodo": "提交相应质量控制记录与报告"
      }
    },
    {
      "id": "T-no-sampling",
      "when": "G10 == finish_stage1",
      "then": {
        "markNotApplicable": [
          "sampling_plan",
          "commission_order",
          "field_records",
          "detection_report",
          "quality_control_records"
        ]
      }
    },
    {
      "id": "T-unexpected",
      "when": "S70.quality_fail || S70.new_pollution_evidence",
      "then": {
        "createProfessionalDecision": "复核、补充调查或重新采样"
      }
    }
  ],
  "bundledAssets": {
    "standardsIndex": [
      "HJ25.1-2019",
      "HJ25.2-2019",
      "MEE-2022-QC"
    ],
    "referenceMaterials": [
      "历史影像调查流程",
      "企业发现和证据核验方法",
      "风险区和布点选择说明",
      "通用质控核验表"
    ],
    "documentMasters": [
      "规范清洁母版v2",
      "稳定第1—7章章节树",
      "现场调查/访谈/点位记录表",
      "独立编制核查事项清单"
    ],
    "automationSkills": [
      "boundary-parser",
      "historical-imagery-gis",
      "enterprise-candidate-map",
      "sampling-plan",
      "evidence-intake",
      "structured-writing",
      "docx-compiler"
    ],
    "assetLifecycle": "each asset must declare installed/available-external/planned, version, origin and applicability"
  },
  "deliverables": [
    {
      "id": "client-report",
      "role": "external",
      "format": [
        "docx",
        "pdf-when-generated"
      ],
      "requirements": [
        "专业审核",
        "规范章节",
        "证据对应",
        "符合分支的真实内容"
      ],
      "exclude": [
        "内部Todo",
        "未经核实企业候选",
        "虚构采样结果"
      ]
    },
    {
      "id": "attachment-index",
      "role": "external",
      "format": [
        "tables",
        "maps",
        "original-attachments"
      ],
      "requirements": [
        "来源可追溯",
        "采样点及附图对应"
      ]
    },
    {
      "id": "authoring-checklist",
      "role": "internal",
      "format": [
        "md",
        "json"
      ],
      "requirements": [
        "未解决问题",
        "人员责任",
        "缺料和复核事项"
      ]
    },
    {
      "id": "audit-ledger",
      "role": "internal",
      "format": [
        "json"
      ],
      "requirements": [
        "原始证据哈希",
        "审批日志",
        "旧版变更记录"
      ]
    }
  ],
  "knownRuntimeGaps": [
    "conditional-stage-branches",
    "material-requirement-runtime",
    "event-generated-human-todos",
    "document-bundle-import",
    "docx-pdf-compilers",
    "evidence-invalidation"
  ],
  "notes": "This is a domain blueprint intended to drive a future schema, not an executable schemaVersion 2 template."
}
