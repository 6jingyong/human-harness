{
  "name": "human-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "codex:smoke": "node --import tsx scripts/codex-smoke.ts",
    "codex:mcp:smoke": "node --import tsx scripts/codex-mcp-smoke.ts",
    "codex:capabilities": "node --import tsx scripts/codex-capabilities.ts",
    "test:codex:mcp": "playwright test --config playwright.native.config.ts",
    "test:browser": "playwright test",
    "codex:abc:live": "node --import tsx scripts/codex-abc-live.ts"
  },
  "dependencies": {
    "@mastra/core": "1.82.0",
    "better-sqlite3": "13.0.3",
    "fflate": "0.8.3",
    "marked": "18.2.1",
    "next": "16.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
