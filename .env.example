# Local demo mode never contacts a model provider.
HH_EXECUTOR=demo
# To execute a real Mastra agent:
# HH_EXECUTOR=mastra
# HH_MODEL=openai/gpt-6.1-sol
# OPENAI_API_KEY=your-key-here

# To run a real local Codex app-server (requires Codex CLI installed + authenticated):
# HH_EXECUTOR=codex
# HH_CODEX_MODEL=your-model-id-from-codex-model-list
# HH_CODEX_COMMAND=codex
# HH_CODEX_TIMEOUT_MS=600000

# Names of trusted read-only MCP tools already configured in Codex, separated by commas.
# HH_CODEX_MCP_READ_ONLY=registry/sample_lookup

# Optional experimental document bridge: enables local shell/installed Skills for
# already accepted PDF/DOCX originals, restricted to per-run temporary workspace.
# HH_CODEX_DOCUMENTS=1
# HH_CODEX_PDF_SKILL=pdf
# HH_CODEX_DOCX_SKILL=docx
