# Local demo mode never contacts a model provider.
HH_EXECUTOR=demo
# To execute a real Mastra agent:
# HH_EXECUTOR=mastra
# HH_MODEL=openai/gpt-6.1-sol
# OPENAI_API_KEY=your-key-here

# To run a real local Codex app-server (requires Codex CLI installed + authenticated):
# HH_EXECUTOR=codex
# HH_CODEX_MODEL=your-model-id-from-codex-model-list
# HH_CODEX_COMMAND=codex
# HH_CODEX_TIMEOUT_MS=600000
# P1.1 accepts text-only tasks; skills, plugins and document parsing are still unverified.
