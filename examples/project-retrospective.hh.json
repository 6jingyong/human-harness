{
  "protocol": "hh.package/1",
  "id": "project-retrospective",
  "version": "1.0.0",
  "title": "项目复盘与改进",
  "description": "比较项目原计划和实际交付，核对工时、等待、返工和成本来源，形成少量可被下一单验证的改进措施。",
  "stages": [
    {
      "id": "intake",
      "title": "准备对照",
      "description": "提供原计划、验收记录和实际投入"
    },
    {
      "id": "review",
      "title": "分析与选择",
      "description": "解释偏差并选定下一轮改进"
    },
    {
      "id": "deliver",
      "title": "复盘归档",
      "description": "生成可验证的改进行动及跟踪方式"
    }
  ],
  "capabilities": [
    {
      "id": "mastra.agent",
      "kind": "agent",
      "description": "受控 Agent 执行，输入遵循项目证据权限"
    }
  ],
  "assets": [],
  "materials": [
    {
      "id": "baseline",
      "title": "原计划与验收标准",
      "producer": "human",
      "formats": [
        "text/plain"
      ],
      "description": "提供原目标、周期、里程碑、预算和验收标准，注明相比的是哪一版计划。",
      "acceptance": [
        "对照范围、日期和计量口径可确认"
      ],
      "planningMinutes": 30
    },
    {
      "id": "actuals",
      "title": "实际结果、事件和投入",
      "producer": "human",
      "formats": [
        "text/plain"
      ],
      "description": "粘贴交付结论、关键事件及可查证的投入。可从项目账务转录实际人工、机构等待和支出，注明币种、工时类别与是否缺项。",
      "acceptance": [
        "数据有来源，现金支出、人工估值和外部等待各有清楚口径"
      ],
      "planningMinutes": 45
    }
  ],
  "steps": [
    {
      "id": "variance",
      "stageId": "review",
      "kind": "agent",
      "title": "核对计划与实际偏差",
      "instructions": "只比较同范围、同时间窗口、同币种或同计量方式的数据，分别记录人工、外部等待、现金费用和交付差异。保留来源与缺项，提出可检验的原因假设。未登记的工时或费用视为未知。",
      "dependsOn": [],
      "needsMaterials": [
        "baseline",
        "actuals"
      ],
      "capabilityId": "mastra.agent",
      "outputContractId": "variance-output",
      "requiresReview": true,
      "planning": {
        "workMinutes": 60,
        "reviewMinutes": 30
      }
    },
    {
      "id": "commit",
      "stageId": "review",
      "kind": "human_action",
      "title": "确认偏差原因与下次改进",
      "instructions": "核对偏差原因，选择少量可执行改进。填写负责人、开始或验收时点，以及下一单用什么数据验证。",
      "dependsOn": [
        "variance"
      ],
      "needsMaterials": [],
      "planning": {
        "workMinutes": 30
      }
    },
    {
      "id": "retrospective",
      "stageId": "deliver",
      "kind": "agent",
      "title": "形成复盘报告及改进表",
      "instructions": "使用已审偏差分析和人工交接意见写复盘。说明仍待验证的原因，区分可控和外部因素。给每个改进写入负责人、验收时点、比较基线和复验方法。 按以下顺序使用原样的 Markdown 二级标题：目标与实际结果、主要偏差、原因与限度、改进行动与验收。",
      "dependsOn": [
        "variance",
        "commit"
      ],
      "needsMaterials": [],
      "capabilityId": "mastra.agent",
      "outputContractId": "retrospective-output",
      "requiresReview": true,
      "planning": {
        "workMinutes": 45,
        "reviewMinutes": 30
      }
    }
  ],
  "outputs": [
    {
      "id": "variance-output",
      "title": "计划与实际偏差清单",
      "audience": "internal",
      "fileName": "variance.md",
      "format": "markdown",
      "producingStepId": "variance",
      "acceptance": [
        "出处及比较口径明确",
        "客观事件、可检验假设和缺项可辨认"
      ],
      "humanSignoff": true
    },
    {
      "id": "retrospective-output",
      "title": "项目复盘报告与改进表",
      "audience": "internal",
      "fileName": "retrospective.md",
      "format": "markdown",
      "producingStepId": "retrospective",
      "acceptance": [
        "结论对应可查证的计划、实际事件和人工确认",
        "下一单可以按所给指标验证改进"
      ],
      "humanSignoff": true,
      "markdown": {
        "headings": [
          {
            "level": 2,
            "title": "目标与实际结果"
          },
          {
            "level": 2,
            "title": "主要偏差"
          },
          {
            "level": 2,
            "title": "原因与限度"
          },
          {
            "level": 2,
            "title": "改进行动与验收"
          }
        ]
      },
      "word": {
        "fileName": "project-retrospective.docx",
        "title": "项目复盘报告与改进表",
        "tocDepth": 2
      },
      "deliverable": true
    }
  ]
}
